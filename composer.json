{
    "name": "lbonnet/crawler-toolkit",
    "type": "library",
    "description": "Shared, framework-agnostic building blocks for polite and safe web crawlers: SSRF-aware HTTP throttling, robots.txt parsing, and HTML link discovery.",
    "keywords": [
        "crawler",
        "robots-txt",
        "http-client",
        "ssrf",
        "html",
        "links"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "lbonnet",
            "homepage": "https://github.com/lbonnet-gda"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8.1",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "symfony/phpunit-bridge": "^6.4 || ^7.4 || ^8.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Lbonnet\\CrawlerToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lbonnet\\CrawlerToolkit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
